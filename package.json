{
  "name": "parallel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Parallel: systematic concurrency testing for instrumented TypeScript programs",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types packages/cli/src/cli.ts test inventory-buggy",
    "demo:fixed": "node --disable-warning=ExperimentalWarning --experimental-strip-types packages/cli/src/cli.ts test inventory-fixed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
